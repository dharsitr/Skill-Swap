# ==============================================================================
# SkillSwap — Production Environment Configuration Template
# ==============================================================================
# Classification:
#   [PUBLIC]  - Safe to expose to client-side bundles (Vite / Browser).
#   [PRIVATE] - Server-side only (Spring Boot backend).
#   [SECRET]  - Sensitive credentials / keys. Must NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration [PUBLIC]
# ------------------------------------------------------------------------------
# Base URL for Backend REST API
VITE_API_URL=http://localhost:8080/api/v1

# Supabase Project URL for authentication & client SDK
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Public Client Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration [PRIVATE]
# ------------------------------------------------------------------------------
# Active Spring profile: dev | test | staging | prod
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Application Base Version
APP_VERSION=0.2.0

# Allowed CORS Origins (comma-separated list, NO trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. Database Configuration (Supabase PostgreSQL) [SECRET]
# ------------------------------------------------------------------------------
# JDBC Connection URL (Supabase Shared Pooler)
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.akrsiounrqwebmdkkoqs
DATABASE_PASSWORD=your-secure-database-password

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 4. Supabase Backend / JWT Authentication [SECRET / PRIVATE]
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_VERIFY_SIGNATURE=false

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Safety Controls [PRIVATE]
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_MUTATION_PER_MINUTE=40
