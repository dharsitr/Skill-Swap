# ==============================================================================
# SkillSwap Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Fill in your project credentials from your Supabase project settings.
# 3. DO NOT commit .env.local or any real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL & Domain Settings
# ------------------------------------------------------------------------------
# Used for canonical metadata, sitemaps, OpenGraph tags, and auth redirect URLs.
# In local development: http://localhost:3000
# In production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Required)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: The unique project URL (e.g., https://xyzcompany.supabase.co)
# NEXT_PUBLIC_SUPABASE_ANON_KEY: The public anonymous API key (JWT)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 3. WebRTC / NAT Traversal Configuration (Optional)
# ------------------------------------------------------------------------------
# Public Google STUN servers (stun.l.google.com:19302) are configured by default.
# For restrictive corporate/firewalled networks in production, configure a TURN server
# (e.g. from Twilio Network Traversal, Metered, Xirsys, or Coturn).
#
# NEXT_PUBLIC_TURN_SERVER_URL=turn:turn.example.com:3478?transport=udp
# NEXT_PUBLIC_TURN_USERNAME=your-turn-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-secret-or-password
